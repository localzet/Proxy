{
  "name": "localzet/proxy",
  "description": "HTTP forward proxy with Basic authentication and an IP/port allowlist, built on Localzet Server.",
  "type": "library",
  "keywords": [
    "HTTP",
    "proxy",
    "server",
    "PHP",
    "library",
    "localzet",
    "AGPL"
  ],
  "license": "AGPL-3.0-or-later",
  "authors": [
    {
      "role": "Developer",
      "name": "Ivan Zorin",
      "email": "creator@localzet.com",
      "homepage": "https://github.com/localzet"
    }
  ],
  "support": {
    "email": "support@localzet.com",
    "issues": "https://github.com/localzet/Proxy/issues",
    "source": "https://github.com/localzet/Proxy"
  },
  "require": {
    "localzet/server": "^7.0",
    "php": ">=8.1"
  },
  "autoload": {
    "psr-4": {
      "localzet\\": "src"
    }
  },
  "scripts": {
    "test": "php tests/regression.php",
    "test:integration": "python3 tests/integration.py",
    "lint": "find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l"
  }
}
